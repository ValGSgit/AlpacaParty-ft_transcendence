# AlpacaParty — Environment Variables
# @owner ValGSgit
# @issue https://github.com/ValGSgit/AlpacaParty/issues/5
#
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── PostgreSQL ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=alpacaparty
DB_USER=alpacaparty
DB_PASSWORD=changeme
DATABASE_URL=postgresql://alpacaparty:changeme@postgres:5432/alpacaparty?schema=public

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-secret-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── Backend ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=/api
FRONTEND_URL=https://localhost:8443

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# ── OAuth 2.0 ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:8443/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://localhost:8443/api/auth/github/callback

# ── AI Help Desk (Groq) ────────────────────────────────────
GROQ_API_KEY=

# ── AI Avatar Generation (Hugging Face) ────────────────────
HUGGINGFACE_API_KEY=

# ── GitHub PAT (server-side only, optional) ─────────────────
# Used for posting GitHub issues from the app. Scope: repo (issues only).
# Never use a token with write access to code.
GITHUB_ISSUES=

# ── File Uploads ────────────────────────────────────────────
UPLOAD_MAX_SIZE=10485760

# ── Public API ──────────────────────────────────────────────
API_KEYS=change-me-to-a-secure-key

# ── Admin / Mod users ───────────────────────────────────────
# Comma-separated usernames that receive isAdmin=true in their JWT.
# Seeded into Vault on first boot. After that, use:
#   make make-admin USER=x        (dev)
#   make prod-make-admin USER=x   (prod)
MOD_USERS=live_admin

# ── HashiCorp Vault ─────────────────────────────────────────
# Dev mode: root token used by the dev vault container (auto-unsealed).
VAULT_DEV_TOKEN=YouCouldLeaveThisAsIsIDGAF

# Production: NO manual token setup required.
# vault-init automatically initializes, unseals, seeds secrets, and writes
# the service token to a shared Docker volume that the backend reads at startup.
# The secrets above (DB_PASSWORD, JWT_SECRET, OAuth keys, etc.) are passed to
# vault-init which seeds them into Vault, then the backend reads them from Vault.
# After first boot those secrets no longer need to be set in .env for the backend.


