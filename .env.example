# AlpacaParty — Environment Variables
# @owner ValGSgit
# @issue https://github.com/ValGSgit/AlpacaParty/issues/5
#
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── PostgreSQL ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=alpacaparty
DB_USER=alpacaparty
DB_PASSWORD=changeme
DATABASE_URL=postgresql://alpacaparty:changeme@postgres:5432/alpacaparty?schema=public

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-secret-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── Backend ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=/api
FRONTEND_URL=https://localhost:8080

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── OAuth 2.0 ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:8080/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://localhost:8080/api/auth/github/callback

# ── AI Help Desk (Groq) ────────────────────────────────────
GROQ_API_KEY=

# ── AI Avatar Generation (Hugging Face) ────────────────────
HUGGINGFACE_API_KEY=

# ── File Uploads ────────────────────────────────────────────
UPLOAD_MAX_SIZE=10485760

# ── Public API ──────────────────────────────────────────────
API_KEYS=change-me-to-a-secure-key

# ── HashiCorp Vault ─────────────────────────────────────────
# Dev mode: root token used by vault container and backend client.
VAULT_DEV_TOKEN=YouCouldLeaveThisAsIsIDGAF
# Production: set VAULT_TOKEN to a limited-policy token after vault operator init.
VAULT_TOKEN=YouCouldLeaveThisAsIsIDGAF
