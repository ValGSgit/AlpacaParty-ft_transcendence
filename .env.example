# AlpacaParty — Environment Variables
# @owner ValGSgit
#
# Copy to .env and fill in your values.
# Never commit .env to version control.

COMPOSE_PROJECT_NAME=alpacaparty

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=alpacaparty
DB_USER=alpacapartyUser
DB_PASSWORD=changeme

# Json Web Token
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_PUBLIC_API_SECRET=
JWT_ADMIN_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_PUBLIC_API_EXPIRES_IN=30d
JWT_ADMIN_EXPIRES_IN=30d

# Backend
NODE_ENV=development
API_PORT=3000
PRISMA_STUDIO_PORT=5555

# Frontend
VITE_API_URL=/api
FRONTEND_URL=https://{MY_IP}:8443

# Cors
CORS_ORIGINS=http://{MY_IP}:5173,https://{MY_IP}:8443,https://{MY_IP}.nip.io:8443

# Public API
PUBLIC_API_HOST={MY_IP}:8443

# OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://{MY_IP}.nip.io:8443/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://{MY_IP}.nip.io:8443/api/auth/github/callback

# Groq AI (help desk)
# Up to 3 keys from console.groq.com — rotated round-robin to spread rate limits
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=

# File Uploads
UPLOAD_MAX_SIZE=10485760

# HashiCorp Vault
VAULT_TOKEN=YourVaultToken
