# AlpacaParty — Environment Variables
# @owner ValGSgit
# @issue https://github.com/ValGSgit/AlpacaParty/issues/5
#
# Copy to .env and fill in your values.
# Never commit .env to version control.

COMPOSE_PROJECT_NAME=alpacaparty

# ── PostgreSQL ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=alpacaparty
DB_USER=alpacaparty
DB_PASSWORD=d6fcb413792d0217e8ade1c915b790c51d0448a2b60e18b5
DATABASE_URL=postgresql://alpacaparty:d6fcb413792d0217e8ade1c915b790c51d0448a2b60e18b5@postgres:5432/alpacaparty?schema=public

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_PUBLIC_API_SECRET=
ADMIN_JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_PUBLIC_API_EXPIRES_IN=30d
# ── Backend ─────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
PRISMA_STUDIO_PORT=5555

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=/api
FRONTEND_URL=https://localhost:8443
# FRONTEND_URL=https://10.13.10.5.nip.io:8443
CORS_ORIGINS=http://localhost:5173,https://localhost:8443,https://10.13.10.5.nip.io:8443


# ── CORS ────────────────────────────────────────────────────
#CORS_ORIGINS=http://localhost:5173,https://localhost:8443

# ── OAuth 2.0 ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://10.13.10.5.nip.io:8443/api/auth/google/callback
#--V-- localhost --V--
GOOGLE_CALLBACK_URL=https://localhost:8443/api/auth/google/callback

#---- LAN ----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://10.13.10.5.nip.io:8443/api/auth/github/callback <- this ip might change so need to update accordingly

#---- localhost ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://localhost:8443/api/auth/github/callback


# ── Groq AI (help desk) ─────────────────────────────────────
# Up to 3 keys from console.groq.com — rotated round-robin to spread rate limits
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=



# Optional: override default model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant
# ── GitHub PAT (server-side only, optional) ─────────────────
# Used for posting GitHub issues from the app. Scope: repo (issues only).
# Never use a token with write access to code.
GITHUB_ISSUES=awdawdawd

# ── File Uploads ────────────────────────────────────────────
UPLOAD_MAX_SIZE=10485760

# ── Public API ──────────────────────────────────────────────
API_KEYS=change-me-to-a-secure-key

# ── HashiCorp Vault ─────────────────────────────────────────
# Dev mode: root token used by the dev vault container (auto-unsealed).
VAULT_DEV_TOKEN=YouCouldLeaveThisAsIsIDGAF

VAULT_ADDR=https://127.0.0.1:8200