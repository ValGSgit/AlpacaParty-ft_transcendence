# AlpacaParty — Environment Variables
#
# Copy to .env and fill in your values.
# Never commit .env to version control.

COMPOSE_PROJECT_NAME=alpacaparty

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=alpacaparty
DB_USER=alpacapartyUser
DB_PASSWORD=changeme

# Prisma connection string. The host MUST be the `postgres` service name (not
# localhost) so it resolves on the Docker network. `make generate-secrets`
# rewrites the password here to match the randomised DB_PASSWORD above.
DATABASE_URL=postgresql://alpacapartyUser:changeme@postgres:5432/alpacaparty?schema=public

# Json Web Token
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_PUBLIC_API_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_PUBLIC_API_EXPIRES_IN=30d

# Backend
NODE_ENV=development
API_PORT=3000
PRISMA_STUDIO_PORT=5555

# Public API keys (comma-separated). `make generate-secrets` populates this
# with a random key; you can rotate it later by re-running that target.
API_KEYS=

# Frontend
VITE_API_URL=/api

# Public API
PUBLIC_API_HOST={MY_IP}:8443

# Frontend URL (used for HTTPS redirects in production)
FRONTEND_URL=https://{MY_IP}:8443

# Cors
CORS_ORIGINS=http://{MY_IP}:5173,https://{MY_IP}:8443,https://{MY_IP}.nip.io:8443

# Groq AI (help desk)
# Up to 3 keys from console.groq.com — rotated round-robin to spread rate limits
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=

# File Uploads
UPLOAD_MAX_SIZE=10485760
