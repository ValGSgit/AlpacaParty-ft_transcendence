# AlpacaParty — Environment Variables
# @owner ValGSgit
# @issue https://github.com/ValGSgit/AlpacaParty/issues/5
#
# Copy to .env and fill in your values.
# Never commit .env to version control.

COMPOSE_PROJECT_NAME=alpacaparty

# ── PostgreSQL ──────────────────────────────────────────────
DB_HOST=postgres_test
DB_PORT=5432
DB_NAME=testdatabase
DB_USER=testuser
DB_PASSWORD=testpass

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-secret-here
JWT_REFRESH_SECRET=generate-a-strong-random-refresh-secret-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Backend ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PORT=3000
PRISMA_STUDIO_PORT=5555

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=/api
FRONTEND_URL=http://localhost:8080

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── OAuth 2.0 ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# ── File Uploads ────────────────────────────────────────────
UPLOAD_MAX_SIZE=10485760

# ── Public API ──────────────────────────────────────────────
API_KEYS=change-me-to-a-secure-key

# ── HashiCorp Vault ─────────────────────────────────────────
# Dev mode: root token used by vault container and backend client.
VAULT_DEV_TOKEN=YouCouldLeaveThisAsIsIDGAF
# Production: set VAULT_TOKEN to a limited-policy token after vault operator init.
VAULT_TOKEN=YouCouldLeaveThisAsIsIDGAF
