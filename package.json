{
  "name": "cleanscendence",
  "version": "0.0.1",
  "description": "Cleanscendence — 42 Transcendence project (Vue 3 + Express + PostgreSQL)",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install && cd ../shared && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules shared/node_modules",
    "test": "cd backend && npm test"
  },
  "keywords": ["cleanscendence", "transcendence", "42", "vue", "express", "postgresql"],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
