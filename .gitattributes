# Normalize line endings
# Shell scripts must always use LF — CRLF breaks the shebang on Linux
*.sh    text eol=lf
*.bash  text eol=lf

# Docker / config files
Dockerfile*    text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.conf         text eol=lf
*.hcl          text eol=lf
*.env          text eol=lf
*.env.example  text eol=lf

# Source files — let git normalise to LF, editors use system default
*.js    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.pem   binary
*.key   binary
*.crt   binary
