# Backend Dockerfile (Production)
# @owner ValGSgit
# @issue https://github.com/ValGSgit/AlpacaParty/issues/3

# ── Stage 1: Build ────────────────────────────────────────────
FROM node:24-alpine3.22 AS builder

WORKDIR /app

# Install deps before copying source — layer is only re-built when package*.json changes.
COPY package*.json ./
RUN npm install --no-audit --no-fund --loglevel=error

# Copy source (after install so code changes don't bust the npm cache layer).
COPY . .

# Generate Prisma client, prune devDeps, and clear npm cache — all in one layer
# so no intermediate fat state is committed to the image.
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" npx prisma generate \
  && npm prune --omit=dev \
  && npm cache clean --force

# ── Stage 2: Runtime ──────────────────────────────────────────
FROM node:24-alpine3.22

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
  adduser -S nodejs -u 1001

# Copy only what the server needs to run — no devDeps, no build tooling, no test files.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src          ./src
COPY --from=builder /app/prisma       ./prisma
COPY --from=builder /app/prisma.config.js ./prisma.config.js
COPY --from=builder /app/package.json ./package.json

# Copy the runtime bootstrap scripts so production can load Vault secrets and
# apply Prisma migrations before the API starts.
COPY --chmod=755 tools/load-secrets.sh /usr/local/bin/load-secrets.sh
COPY --chmod=755 tools/prod-entrypoint.sh /usr/local/bin/prod-entrypoint.sh

# Create runtime-writable directories for the non-root user.
RUN mkdir -p /app/uploads /run/secrets && \
  chown -R nodejs:nodejs /app/uploads /run/secrets

USER nodejs

EXPOSE 3000

ENTRYPOINT ["prod-entrypoint.sh"]

# Start the server after the entrypoint has loaded secrets and applied
# migrations.
CMD ["node", "src/server.js"]
